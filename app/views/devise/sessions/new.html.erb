<% content_for :title, "Sign in" %>

<div class="mx-auto max-w-md py-6">
  <div class="rounded-3xl border border-zinc-200 bg-white p-8 shadow-sm sm:p-10">
    <p class="text-sm font-semibold uppercase tracking-[0.3em] text-emerald-600">Mas Futbol</p>
    <h1 class="mt-3 text-3xl font-black">Welcome back</h1>
    <p class="mt-2 text-zinc-500">Sign in to your account.</p>

    <div class="mt-8 space-y-3">
      <%= button_to "Continue with Google", user_google_oauth2_omniauth_authorize_path,
            form: { data: { turbo: false } },
            class: "w-full cursor-pointer rounded-full border border-zinc-300 bg-white px-5 py-3 font-semibold text-zinc-900 transition hover:bg-zinc-50" %>
      <%= button_to "Continue with GitHub", user_github_omniauth_authorize_path,
            form: { data: { turbo: false } },
            class: "w-full cursor-pointer rounded-full bg-zinc-900 px-5 py-3 font-semibold text-white transition hover:bg-zinc-700" %>
    </div>

    <div class="my-8 flex items-center gap-4 text-sm text-zinc-400">
      <div class="h-px flex-1 bg-zinc-200"></div>
      or use your email
      <div class="h-px flex-1 bg-zinc-200"></div>
    </div>

    <% input = "mt-2 block w-full rounded-xl border border-zinc-300 px-4 py-3 focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/20" %>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-5" }) do |f| %>
      <div>
        <%= f.label :email, class: "block text-sm font-semibold" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: input %>
      </div>

      <div>
        <%= f.label :password, class: "block text-sm font-semibold" %>
        <%= f.password_field :password, autocomplete: "current-password", class: input %>
      </div>

      <% if devise_mapping.rememberable? %>
        <label class="flex items-center gap-2 text-sm text-zinc-600">
          <%= f.check_box :remember_me, class: "h-4 w-4 accent-emerald-600" %>
          Remember me
        </label>
      <% end %>

      <%= f.submit "Sign in",
            class: "w-full cursor-pointer rounded-full bg-emerald-600 px-5 py-3 font-bold text-white transition hover:bg-emerald-500" %>
    <% end %>
  </div>

  <p class="mt-6 text-center text-sm text-zinc-500">
    Just browsing? No account needed to check out.
    <%= link_to "Shop jerseys →", jerseys_path, class: "font-semibold text-emerald-600 hover:underline" %>
  </p>
</div>