<%= link_to jersey_path(jersey), class: "group block rounded-2xl border border-zinc-200 bg-white p-5 transition hover:-translate-y-1 hover:border-emerald-500 hover:shadow-xl" do %>
  <div class="relative flex aspect-[4/3] items-center justify-center rounded-xl bg-zinc-100 text-6xl transition group-hover:bg-emerald-50">
    👕
    <% if jersey.category %>
      <span class="absolute left-3 top-3 rounded-full bg-white px-2.5 py-1 text-xs font-semibold text-zinc-700 shadow-sm">
        <%= jersey.category.name %>
      </span>
    <% end %>
  </div>

  <p class="mt-4 text-xs font-semibold uppercase tracking-widest text-zinc-500">
    <%= [jersey.club, jersey.season].compact_blank.join(" · ") %>
  </p>
  <h3 class="mt-1 line-clamp-1 text-lg font-bold transition group-hover:text-emerald-600"><%= jersey.title %></h3>

  <div class="mt-3 flex items-center justify-between">
    <span class="text-xl font-black"><%= number_to_currency(jersey.price) %></span>
    <% if jersey.size.present? %>
      <span class="rounded-md border border-zinc-300 px-2.5 py-0.5 text-sm font-semibold"><%= jersey.size %></span>
    <% end %>
  </div>
<% end %>