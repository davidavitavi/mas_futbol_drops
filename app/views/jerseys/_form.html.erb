<% input = "mt-2 block w-full rounded-xl border border-zinc-300 bg-white px-4 py-3 focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/20" %>
<% label = "block text-sm font-semibold" %>

<%= form_with(model: jersey, class: "space-y-6") do |form| %>
  <% if jersey.errors.any? %>
    <div id="error_explanation" class="rounded-2xl bg-red-50 p-5 text-red-700">
      <p class="font-bold"><%= pluralize(jersey.errors.count, "problem") %> to fix before saving:</p>
      <ul class="mt-2 list-disc pl-5 text-sm">
        <% jersey.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# Depop-style photo picker: select or drop several photos at once, preview, remove. %>
  <div data-controller="photo-upload"
       data-photo-upload-max-value="<%= Jersey::MAX_PHOTOS %>"
       data-photo-upload-max-bytes-value="<%= Jersey::MAX_PHOTO_SIZE %>"
       data-photo-upload-types-value="<%= Jersey::PHOTO_TYPES.join(",") %>"
       data-action="dragover->photo-upload#dragOver dragleave->photo-upload#dragLeave drop->photo-upload#drop"
       class="rounded-2xl border border-zinc-200 bg-zinc-50 p-4 transition sm:p-5">
    <div class="flex flex-wrap items-baseline justify-between gap-2">
      <span class="<%= label %>">Photos</span>
      <span class="text-sm text-zinc-500">
        <span data-photo-upload-target="count">0</span>/<%= Jersey::MAX_PHOTOS %> · first photo is the cover
      </span>
    </div>

    <div data-photo-upload-target="grid" class="mt-3 grid grid-cols-3 gap-3 sm:grid-cols-4">
      <% jersey.ordered_photos.select(&:persisted?).each do |photo| %>
        <div data-photo-tile data-crop-src="<%= url_for(photo.variant(:large)) %>"
             class="group relative aspect-square overflow-hidden rounded-xl border border-zinc-200 bg-white">
          <%= cropped_photo_tag jersey, photo, :thumb, data: { tile_image: true } %>
          <%= hidden_field_tag "jersey[photos][]", photo.signed_id, id: nil %>
          <%= hidden_field_tag "photo_crops[]", jersey.crop_for(photo).values_at("x", "y", "zoom").join(","), id: nil, data: { crop_input: true } %>
          <span data-cover-badge class="absolute bottom-2 left-2 hidden rounded-full bg-zinc-950/80 px-2 py-0.5 text-xs font-bold text-white">Cover</span>
          <button type="button" data-action="photo-upload#openCropper" aria-label="Crop photo"
                  class="absolute bottom-1.5 right-1.5 cursor-pointer rounded-full bg-white/90 px-2.5 py-1 text-xs font-bold text-zinc-900 shadow transition hover:bg-emerald-500 hover:text-white">Crop</button>
          <button type="button" data-action="photo-upload#removeExisting" aria-label="Remove photo"
                  class="absolute right-1.5 top-1.5 flex h-7 w-7 cursor-pointer items-center justify-center rounded-full bg-white/90 text-sm font-bold text-zinc-900 shadow transition hover:bg-red-500 hover:text-white">✕</button>
        </div>
      <% end %>

      <label data-photo-upload-target="dropzone"
             for="<%= form.field_id(:photos) %>"
             class="flex aspect-square cursor-pointer flex-col items-center justify-center gap-1 rounded-xl border-2 border-dashed border-zinc-300 bg-white text-center text-zinc-500 transition hover:border-emerald-500 hover:text-emerald-600">
        <span class="text-3xl leading-none">+</span>
        <span class="px-2 text-xs font-semibold">Add photos</span>
      </label>
    </div>

    <%= form.file_field :photos, multiple: true, accept: Jersey::PHOTO_TYPES.join(","), class: "sr-only",
          data: { photo_upload_target: "input", action: "change->photo-upload#pick" } %>

    <p class="mt-3 text-sm text-zinc-500">
      Select several at once or drag them in from a folder. Use Crop to frame each one. JPG, PNG or WEBP, up to 10 MB each.
    </p>
    <p data-photo-upload-target="error" class="mt-2 hidden text-sm font-semibold text-red-600"></p>

    <%# Crop editor: drag to reposition, slider/scroll to zoom. The original photo is never changed. %>
    <div data-photo-upload-target="cropper" role="dialog" aria-modal="true" aria-label="Crop photo"
         data-action="keydown@window->photo-upload#cropKey"
         class="fixed inset-0 z-50 hidden items-center justify-center bg-zinc-950/80 p-4">
      <div class="w-full max-w-md rounded-3xl bg-white p-5 shadow-2xl">
        <div class="flex items-baseline justify-between">
          <h2 class="text-lg font-black">Crop photo</h2>
          <span class="text-sm text-zinc-500">Drag to move · zoom to frame</span>
        </div>

        <div data-photo-upload-target="cropFrame"
             data-action="pointerdown->photo-upload#cropStart wheel->photo-upload#cropWheel:!passive"
             class="relative mt-4 aspect-square cursor-grab touch-none select-none overflow-hidden rounded-2xl bg-white ring-1 ring-zinc-200 active:cursor-grabbing">
          <img data-photo-upload-target="cropImage" alt="" draggable="false"
               class="pointer-events-none absolute max-w-none">
          <%# rule-of-thirds guides %>
          <div class="pointer-events-none absolute inset-0 grid grid-cols-3 grid-rows-3">
            <% 9.times do %><div class="border border-zinc-400/25"></div><% end %>
          </div>
        </div>

        <div class="mt-5 flex items-center gap-3">
          <span class="text-lg font-bold text-zinc-400" aria-hidden="true">−</span>
          <input type="range" min="<%= Jersey::ZOOM_RANGE.begin %>" max="<%= Jersey::ZOOM_RANGE.end %>" step="0.01" value="1"
                 aria-label="Zoom" data-photo-upload-target="zoom" data-action="input->photo-upload#cropZoom"
                 class="w-full cursor-pointer accent-emerald-600">
          <span class="text-lg font-bold text-zinc-400" aria-hidden="true">+</span>
        </div>

        <div class="mt-5 flex items-center justify-between gap-3">
          <button type="button" data-action="photo-upload#cropReset"
                  class="cursor-pointer text-sm font-semibold text-zinc-500 hover:text-zinc-900">Reset</button>
          <div class="flex gap-2">
            <button type="button" data-action="photo-upload#closeCropper"
                    class="cursor-pointer rounded-full px-5 py-2.5 font-semibold text-zinc-600 hover:bg-zinc-100">Cancel</button>
            <button type="button" data-action="photo-upload#cropDone"
                    class="cursor-pointer rounded-full bg-emerald-600 px-6 py-2.5 font-bold text-white hover:bg-emerald-500">Done</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div>
    <%= form.label :title, class: label %>
    <%= form.text_field :title, placeholder: "e.g. Barcelona Home 2015", class: input %>
  </div>

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <%= form.label :club, class: label %>
      <%= form.text_field :club, placeholder: "e.g. FC Barcelona", class: input %>
    </div>
    <div>
      <%= form.label :category_id, "League", class: label %>
      <%= form.collection_select :category_id, Category.order(:name), :id, :name,
            { include_blank: "No league" }, class: input %>
    </div>
  </div>

  <div class="grid gap-6 sm:grid-cols-3">
    <div>
      <%= form.label :season, class: label %>
      <%= form.text_field :season, placeholder: "2015/16", class: input %>
    </div>
    <div>
      <%= form.label :size, class: label %>
      <%= form.select :size, %w[XS S M L XL XXL], { include_blank: "Select" }, class: input %>
    </div>
    <div>
      <%= form.label :price, class: label %>
      <div class="relative">
        <span class="pointer-events-none absolute left-4 top-1/2 mt-1 -translate-y-1/2 text-zinc-500">$</span>
        <%= form.number_field :price, step: 0.01, min: 0, placeholder: "89.99", class: "#{input} pl-8" %>
      </div>
    </div>
  </div>

  <div>
    <%= form.label :description, class: label %>
    <%= form.textarea :description, rows: 5, placeholder: "Condition, fit, any flaws, what makes it special…", class: input %>
  </div>

  <div class="flex flex-wrap items-center gap-4 border-t border-zinc-200 pt-6">
    <%= form.submit class: "cursor-pointer rounded-full bg-emerald-600 px-8 py-3 font-bold text-white transition hover:bg-emerald-500" %>
    <%= link_to "Cancel", jersey.persisted? ? jersey_path(jersey) : jerseys_path,
          class: "font-semibold text-zinc-500 hover:text-zinc-900" %>
  </div>
<% end %>