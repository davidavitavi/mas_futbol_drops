<% content_for :title, "Jerseys" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-600 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex items-center justify-between">
    <h1 class="text-4xl font-black"><%= @category ? @category.name : "All jerseys" %></h1>
    <% if current_user&.admin? %>
      <%= link_to "+ New jersey", new_jersey_path,
            class: "rounded-full bg-emerald-600 px-5 py-2.5 font-bold text-white hover:bg-emerald-500 transition" %>
    <% end %>
  </div>

  <% pill = "rounded-full px-4 py-2 text-sm font-semibold transition" %>
  <% active = "bg-emerald-600 text-white" %>
  <% inactive = "bg-zinc-100 text-zinc-700 hover:bg-zinc-200" %>

  <div class="mt-6 flex flex-wrap gap-2">
    <%= link_to "All", jerseys_path(query: params[:query].presence),
          class: [pill, @category.nil? ? active : inactive] %>
    <% @categories.each do |category| %>
      <%= link_to category.name, jerseys_path(category: category, query: params[:query].presence),
            class: [pill, category == @category ? active : inactive] %>
    <% end %>
  </div>

  <% if params[:query].present? %>
    <p class="mt-4 text-zinc-500">
      Results for "<%= params[:query] %>" ·
      <%= link_to "Clear search", jerseys_path(category: @category), class: "font-semibold text-emerald-600 hover:underline" %>
    </p>
  <% end %>

  <% if @jerseys.any? %>
    <div id="jerseys" class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <% @jerseys.each do |jersey| %>
        <%= link_to jersey_path(jersey), class: "group block rounded-2xl border border-zinc-200 p-6 hover:border-emerald-500 hover:shadow-lg transition" do %>
          <div class="flex h-40 items-center justify-center rounded-xl bg-zinc-100 text-5xl group-hover:bg-emerald-50 transition">👕</div>
          <div class="mt-4 flex items-center justify-between gap-2">
            <p class="text-xs font-semibold uppercase tracking-widest text-zinc-500">
              <%= [jersey.club, jersey.season].compact_blank.join(" · ") %>
            </p>
            <% if jersey.category %>
              <span class="shrink-0 rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700"><%= jersey.category.name %></span>
            <% end %>
          </div>
          <h3 class="mt-1 text-lg font-bold group-hover:text-emerald-600"><%= jersey.title %></h3>
          <div class="mt-3 flex items-center justify-between">
            <span class="text-xl font-black"><%= number_to_currency(jersey.price) %></span>
            <% if jersey.size.present? %>
              <span class="rounded-full bg-zinc-100 px-3 py-1 text-sm font-semibold"><%= jersey.size %></span>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="mt-8 rounded-2xl border-2 border-dashed border-zinc-300 p-12 text-center text-zinc-500">
      No jerseys found.
    </div>
  <% end %>
</div>