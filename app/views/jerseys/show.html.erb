<% content_for :title, @jersey.title %>



<nav class="flex flex-wrap items-center gap-2 text-sm text-zinc-500">
  <%= link_to "Shop", jerseys_path, class: "hover:text-emerald-600" %>
  <% if @jersey.category %>
    <span>/</span>
    <%= link_to @jersey.category.name, jerseys_path(category: @jersey.category), class: "hover:text-emerald-600" %>
  <% end %>
  <span>/</span>
  <span class="text-zinc-900"><%= @jersey.title %></span>
</nav>

<div class="mt-6 grid gap-10 lg:grid-cols-2 lg:gap-16">
  <% photos = @jersey.ordered_photos %>
  <div data-controller="gallery"
       data-gallery-zoom-urls-value="<%= photos.map { |photo| url_for(photo.variant(:zoom)) }.to_json %>">
    <div class="relative flex aspect-square items-center justify-center overflow-hidden rounded-3xl bg-zinc-100 text-[8rem]">
      <% if photos.any? %>
        <% photos.each_with_index do |photo, i| %>
          <button type="button" data-gallery-target="slide" data-action="gallery#open"
                  aria-label="Zoom in on photo <%= i + 1 %>"
                  class="absolute inset-0 cursor-zoom-in <%= "hidden" unless i.zero? %>">
            <%= cropped_photo_tag @jersey, photo, :large, alt: i.zero? ? @jersey.title : "", loading: (i.zero? ? "eager" : "lazy") %>
          </button>
        <% end %>
        <span class="pointer-events-none absolute bottom-4 right-4 rounded-full bg-white/90 px-3 py-1.5 text-sm font-semibold shadow-sm">🔍 Tap to zoom</span>
      <% else %>
        👕
      <% end %>
      <% if @jersey.category %>
        <span class="pointer-events-none absolute left-5 top-5 rounded-full bg-white px-3 py-1.5 text-sm font-semibold shadow-sm"><%= @jersey.category.name %></span>
      <% end %>
    </div>

    <% if photos.size > 1 %>
      <div class="mt-4 grid grid-cols-5 gap-3 sm:grid-cols-6">
        <% photos.each_with_index do |photo, i| %>
          <button type="button"
                  data-gallery-target="thumb"
                  data-action="gallery#show"
                  data-gallery-index-param="<%= i %>"
                  aria-label="Show photo <%= i + 1 %> of <%= photos.size %>"
                  class="relative aspect-square cursor-pointer overflow-hidden rounded-xl bg-zinc-100 ring-2 ring-offset-2 transition <%= i.zero? ? "ring-emerald-500" : "ring-transparent hover:ring-zinc-300" %>">
            <%= cropped_photo_tag @jersey, photo, :thumb %>
          </button>
        <% end %>
      </div>
    <% end %>

    <% if photos.any? %>
      <%# Customer magnifier: the full, uncropped photo so buyers can inspect details. %>
      <div data-gallery-target="lightbox" role="dialog" aria-modal="true" aria-label="Photo viewer"
           data-action="keydown@window->gallery#key"
           class="fixed inset-0 z-50 hidden flex-col bg-zinc-950/95 text-white">
        <div class="flex items-center justify-between px-5 py-4">
          <span class="text-sm font-semibold text-zinc-300"><span data-gallery-target="counter">1</span> / <%= photos.size %></span>
          <button type="button" data-action="gallery#close" aria-label="Close"
                  class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-full bg-white/10 text-xl hover:bg-white/20">✕</button>
        </div>

        <div class="relative min-h-0 flex-1 overflow-hidden">
          <img data-gallery-target="zoomImage" alt="<%= @jersey.title %>" draggable="false"
               data-action="click->gallery#toggleZoom pointermove->gallery#pan"
               class="h-full w-full cursor-zoom-in select-none object-contain transition-transform duration-200 ease-out">

          <% if photos.size > 1 %>
            <button type="button" data-action="gallery#previous" aria-label="Previous photo"
                    class="absolute left-3 top-1/2 flex h-12 w-12 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full bg-white/10 text-2xl hover:bg-white/20">‹</button>
            <button type="button" data-action="gallery#next" aria-label="Next photo"
                    class="absolute right-3 top-1/2 flex h-12 w-12 -translate-y-1/2 cursor-pointer items-center justify-center rounded-full bg-white/10 text-2xl hover:bg-white/20">›</button>
          <% end %>
        </div>

        <p class="px-5 py-4 text-center text-sm text-zinc-400">Tap the photo to zoom in · move around to inspect details</p>
      </div>
    <% end %>
  </div>

  <div class="flex flex-col">
    <p class="text-sm font-semibold uppercase tracking-widest text-emerald-600">
      <%= [@jersey.club, @jersey.season].compact_blank.join(" · ") %>
    </p>
    <h1 class="mt-2 text-4xl font-black leading-tight md:text-5xl"><%= @jersey.title %></h1>
    <p class="mt-4 text-3xl font-black"><%= number_to_currency(@jersey.price) %></p>

    <% if @jersey.size.present? %>
      <div class="mt-8">
        <p class="text-sm font-semibold text-zinc-500">Size</p>
        <span class="mt-2 inline-flex h-12 min-w-12 items-center justify-center rounded-xl border-2 border-zinc-900 px-4 font-bold">
          <%= @jersey.size %>
        </span>
        <p class="mt-2 text-sm text-zinc-500">One of one. Only this size available.</p>
      </div>
    <% end %>

    <%= button_to "Buy now · #{number_to_currency(@jersey.price)}", jersey_checkout_path(@jersey),
          form: { data: { turbo: false }, class: "mt-8" },
          class: "w-full cursor-pointer rounded-full bg-emerald-600 px-8 py-4 text-lg font-bold text-white transition hover:bg-emerald-500" %>

    <ul class="mt-6 space-y-2 text-sm text-zinc-600">
      <li>🔒 Secure checkout powered by Stripe</li>
      <li>📦 Every kit inspected before it ships</li>
      <li>💬 Questions? Reach out anytime</li>
    </ul>

    <% if @jersey.description.present? %>
      <div class="mt-10 border-t border-zinc-200 pt-8">
        <h2 class="text-lg font-bold">About this jersey</h2>
        <p class="mt-3 leading-relaxed text-zinc-600"><%= @jersey.description %></p>
      </div>
    <% end %>

    <% if current_user&.admin? %>
      <div class="mt-10 flex flex-wrap items-center gap-3 rounded-2xl border border-dashed border-zinc-300 p-4">
        <span class="text-sm font-semibold text-zinc-500">Admin</span>
        <%= link_to "Edit", edit_jersey_path(@jersey),
              class: "rounded-full bg-zinc-100 px-4 py-2 text-sm font-semibold hover:bg-zinc-200" %>
        <%= button_to "Delete", @jersey, method: :delete,
              form: { data: { turbo_confirm: "Delete this jersey?" } },
              class: "cursor-pointer rounded-full bg-red-50 px-4 py-2 text-sm font-semibold text-red-700 hover:bg-red-100" %>
      </div>
    <% end %>
  </div>
</div>

<% if @related.any? %>
  <section class="mt-20">
    <h2 class="text-2xl font-black">
      More from <%= @jersey.category&.name || "the shop" %>
    </h2>
    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      <%= render partial: "jerseys/card", collection: @related, as: :jersey %>
    </div>
  </section>
<% end %>