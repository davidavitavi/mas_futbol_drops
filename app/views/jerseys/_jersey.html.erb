<div id="<%= dom_id jersey %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Title:</strong>
    <%= jersey.title %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Club:</strong>
    <%= jersey.club %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Season:</strong>
    <%= jersey.season %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Size:</strong>
    <%= jersey.size %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Price:</strong>
    <%= jersey.price %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Description:</strong>
    <%= jersey.description %>
  </div>
</div>
